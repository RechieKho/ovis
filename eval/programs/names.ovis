# Shouts every name.
# expect "name in uppercase" is name in capitals
# expect "number of names" is length of names
# expect "first of names" is first item of names
names = ["ann", "bo", "cyd"]
at the end, free names
for each name in names:
    with new memory:
        shout = name in uppercase
        show shout
show "There are", number of names, "names"
sort names
show "First:", the first of names
