# Cleans up after each task with `at the end`.
# expect nothing unclear
tasks = ["sweep", "dust", "mop"]
for each task in tasks:
    show "Starting", task
    at the end, show "Finished", task
        Compiler: runs at the end of every pass of the loop.
    if task = "dust":
        stop
at the end:
    show "All tidy"
    show "Tasks:", length of tasks
