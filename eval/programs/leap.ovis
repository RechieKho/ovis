# Leap years between 1996 and 2004, and 1900 and 2000.
# expect nothing unclear
to (year) is a leap year:
    if year is divisible by 400:
        give back true
    if year is divisible by 100:
        give back false
    give back year is divisible by 4
years = [1996, 1999, 2000, 1900, 2004]
at the end, free years
for each year in years:
    if year is a leap year:
        show year, "is a leap year"
