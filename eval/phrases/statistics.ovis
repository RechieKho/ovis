# A sample for timing the phrase front end. "mean of numbers" isn't a
# phrase Ovis knows, so building it asks the model one question.
numbers = [12, 7, 30, 18, 4]
show "Numbers:", numbers
show "Smallest:", smallest of numbers, "Largest:", largest of numbers
result = mean of numbers
show "Average:", result rounded to 2 decimals

for each n in numbers:
    if n is even:
        show n, "is even"
    otherwise if n > 10:
        show n, "is odd and big"
    otherwise:
        show n, "is odd"

count = 0
repeat 3 times:
    count = count + 2
show "Count:", count
