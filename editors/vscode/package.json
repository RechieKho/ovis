{
  "name": "ovis",
  "displayName": "Ovis",
  "description": "Ovis, programs written in plain English: problems, quick fixes for unclear lines, and dimmed @[…] lines.",
  "version": "0.1.0",
  "publisher": "ovis",
  "license": "MIT",
  "engines": { "vscode": "^1.82.0" },
  "categories": ["Programming Languages"],
  "main": "./extension.js",
  "activationEvents": ["onLanguage:ovis"],
  "contributes": {
    "languages": [
      {
        "id": "ovis",
        "aliases": ["Ovis"],
        "extensions": [".ovis"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "ovis",
        "scopeName": "source.ovis",
        "path": "./syntaxes/ovis.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Ovis",
      "properties": {
        "ovis.path": {
          "type": "string",
          "default": "ovis",
          "description": "The ovis executable, which the extension starts as `ovis lsp`."
        },
        "ovis.dimSigils": {
          "type": "boolean",
          "default": true,
          "description": "Show the lines Ovis writes (@[meaning: …], @[note: …]) faint, so your own lines stand out."
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "9.0.1"
  }
}
