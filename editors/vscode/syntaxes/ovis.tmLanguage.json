{
  "name": "Ovis",
  "scopeName": "source.ovis",
  "patterns": [
    { "include": "#sigil" },
    { "include": "#comment" },
    { "include": "#text" },
    { "include": "#number" },
    { "include": "#declaration" },
    { "include": "#keyword" }
  ],
  "repository": {
    "sigil": {
      "comment": "A line Ovis writes about the line under it: never code.",
      "name": "comment.line.sigil.ovis",
      "match": "^\\s*(@\\[)(meaning|note)(:)(.*)(\\])\\s*$",
      "captures": {
        "1": { "name": "punctuation.definition.sigil.ovis" },
        "2": { "name": "keyword.other.sigil.ovis" },
        "5": { "name": "punctuation.definition.sigil.ovis" }
      }
    },
    "comment": {
      "name": "comment.line.number-sign.ovis",
      "match": "^\\s*#.*$"
    },
    "text": {
      "name": "string.quoted.double.ovis",
      "begin": "\"",
      "end": "\"",
      "patterns": [{ "name": "constant.character.escape.ovis", "match": "\\\\." }]
    },
    "number": {
      "name": "constant.numeric.ovis",
      "match": "(?<![\\w.])-?\\d+(\\.\\d+)?(?![\\w])"
    },
    "declaration": {
      "comment": "`a book has:`, `a shape can:`, `to greet (p: person):`",
      "match": "^(an?)\\s+([\\w ]+?)\\s+(has|can)(:)\\s*$",
      "captures": {
        "1": { "name": "keyword.other.ovis" },
        "2": { "name": "entity.name.type.ovis" },
        "3": { "name": "keyword.other.ovis" }
      }
    },
    "keyword": {
      "name": "keyword.control.ovis",
      "match": "\\b(if|otherwise|else|while|for each|for|in|repeat|times|give back|stop|skip|use|at the end|defer|to|and|or|not|true|false|nothing)\\b"
    }
  }
}
