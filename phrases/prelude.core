; Ovis Core functions behind phrases that need more than one form (a
; template stands for exactly one). Compiled into every phrase program.

(fn prelude_sum_int ((xs int[])) int
  (let total 0)
  (each x xs (set total (+ total x)))
  (return total))

(fn prelude_sum_float ((xs float[])) float
  (let total 0.0)
  (each x xs (set total (+ total x)))
  (return total))

(fn prelude_min_int ((xs int[])) int
  (let best (get xs 0))
  (each x xs (set best (min best x)))
  (return best))

(fn prelude_min_float ((xs float[])) float
  (let best (get xs 0))
  (each x xs (set best (min best x)))
  (return best))

(fn prelude_max_int ((xs int[])) int
  (let best (get xs 0))
  (each x xs (set best (max best x)))
  (return best))

(fn prelude_max_float ((xs float[])) float
  (let best (get xs 0))
  (each x xs (set best (max best x)))
  (return best))

; Lists: one function per element type, as Ovis Core has no generics.

(fn prelude_contains_int ((xs int[]) (x int)) bool
  (each y xs (if (= y x) (then (return true))))
  (return false))

(fn prelude_contains_float ((xs float[]) (x float)) bool
  (each y xs (if (= y x) (then (return true))))
  (return false))

(fn prelude_contains_str ((xs str[]) (x str)) bool
  (each y xs (if (= y x) (then (return true))))
  (return false))

; Positions count from 1; 0 when it isn't there.
(fn prelude_position_int ((xs int[]) (x int)) int
  (let i 0)
  (each y xs (set i (+ i 1)) (if (= y x) (then (return i))))
  (return 0))

(fn prelude_position_float ((xs float[]) (x float)) int
  (let i 0)
  (each y xs (set i (+ i 1)) (if (= y x) (then (return i))))
  (return 0))

(fn prelude_position_str ((xs str[]) (x str)) int
  (let i 0)
  (each y xs (set i (+ i 1)) (if (= y x) (then (return i))))
  (return 0))

(fn prelude_count_int ((xs int[]) (x int)) int
  (let n 0)
  (each y xs (if (= y x) (then (set n (+ n 1)))))
  (return n))

(fn prelude_count_float ((xs float[]) (x float)) int
  (let n 0)
  (each y xs (if (= y x) (then (set n (+ n 1)))))
  (return n))

(fn prelude_count_str ((xs str[]) (x str)) int
  (let n 0)
  (each y xs (if (= y x) (then (set n (+ n 1)))))
  (return n))

(fn prelude_range ((a int) (b int)) int[]
  (let xs (array int 0))
  (for i a b (append xs i))
  (return xs))

(fn prelude_range_down ((a int) (b int)) int[]
  (let xs (array int 0))
  (for-down i a b (append xs i))
  (return xs))

(fn prelude_join ((xs str[]) (sep str)) str
  (let result "")
  (let first true)
  (each x xs
    (if first (then (set first false)) (else (set result (+ result sep))))
    (set result (+ result x)))
  (return result))

; Input with a prompt on the same line (reading flushes the output).

(fn prelude_ask_int ((prompt str)) int
  (printf "%s " prompt)
  (return (read_int)))

(fn prelude_ask_float ((prompt str)) float
  (printf "%s " prompt)
  (return (read_float)))

(fn prelude_ask_line ((prompt str)) str
  (printf "%s " prompt)
  (return (read_line)))

; Numbers.

(fn prelude_fixed ((x float) (n int)) str
  (let text (buffer 64))
  (snprintf text 64 "%.*f" n x)
  (return text))

(fn prelude_between ((x float) (a float) (b float)) bool
  (return (and (>= x a) (<= x b))))

; Text. Positions count from 1.

(fn prelude_part ((s str) (a int) (b int)) str
  (return (substring s (- a 1) (+ (- b a) 1))))

(fn prelude_text_contains ((s str) (t str)) bool
  (return (!= (strstr s t) null)))

(fn prelude_starts_with ((s str) (t str)) bool
  (if (> (strlen t) (strlen s)) (then (return false)))
  (return (= (substring s 0 (strlen t)) t)))

(fn prelude_ends_with ((s str) (t str)) bool
  (let n (strlen s))
  (let m (strlen t))
  (if (> m n) (then (return false)))
  (return (= (substring s (- n m) m) t)))

(fn prelude_text_position ((s str) (t str)) int
  (let n (strlen s))
  (let m (strlen t))
  (for i 0 (- n m)
    (if (= (substring s i m) t) (then (return (+ i 1)))))
  (return 0))

(fn prelude_upper ((s str)) str
  (let result "")
  (for i 0 (- (strlen s) 1)
    (set result (+ result (chr (toupper (char_at s i))))))
  (return result))

(fn prelude_lower ((s str)) str
  (let result "")
  (for i 0 (- (strlen s) 1)
    (set result (+ result (chr (tolower (char_at s i))))))
  (return result))

(fn prelude_reverse_text ((s str)) str
  (let result "")
  (for i 0 (- (strlen s) 1)
    (set result (+ (substring s i 1) result)))
  (return result))

(fn prelude_trim ((s str)) str
  (let a 0)
  (let b (- (strlen s) 1))
  (while (and (<= a b) (!= (isspace (char_at s a)) 0)) (set a (+ a 1)))
  (while (and (>= b a) (!= (isspace (char_at s b)) 0)) (set b (- b 1)))
  (return (substring s a (+ (- b a) 1))))

(fn prelude_repeat_text ((s str) (n int)) str
  (let result "")
  (for i 1 n (set result (+ result s)))
  (return result))

(fn prelude_replace ((s str) (a str) (b str)) str
  (let m (strlen a))
  (if (= m 0) (then (return s)))
  (let n (strlen s))
  (let result "")
  (let i 0)
  (while (< i n)
    (if (and (<= (+ i m) n) (= (substring s i m) a))
      (then (set result (+ result b)) (set i (+ i m)))
      (else (set result (+ result (substring s i 1))) (set i (+ i 1)))))
  (return result))

; Splits at every `sep`, leaving out empty parts (so several spaces between
; words make no empty words).
(fn prelude_split ((s str) (sep str)) str[]
  (let parts (array str 0))
  (let current "")
  (let n (strlen s))
  (let m (strlen sep))
  (let i 0)
  (while (< i n)
    (if (and (> m 0) (and (<= (+ i m) n) (= (substring s i m) sep)))
      (then
        (if (> (strlen current) 0) (then (append parts current)))
        (set current "")
        (set i (+ i m)))
      (else
        (set current (+ current (substring s i 1)))
        (set i (+ i 1)))))
  (if (> (strlen current) 0) (then (append parts current)))
  (return parts))

(fn prelude_count_words ((s str)) int
  (let words 0)
  (let in_word false)
  (for i 0 (- (strlen s) 1)
    (if (!= (isalnum (char_at s i)) 0)
      (then
        (if (not in_word) (then (set words (+ words 1))))
        (set in_word true))
      (else (set in_word false))))
  (return words))

(fn prelude_count_letters ((s str)) int
  (let letters 0)
  (for i 0 (- (strlen s) 1)
    (if (!= (isalpha (char_at s i)) 0) (then (set letters (+ letters 1)))))
  (return letters))

(fn prelude_min_str ((xs str[])) str
  (let best (get xs 0))
  (each x xs (if (< x best) (then (set best x))))
  (return best))

(fn prelude_max_str ((xs str[])) str
  (let best (get xs 0))
  (each x xs (if (> x best) (then (set best x))))
  (return best))

(fn prelude_contains_bool ((xs bool[]) (x bool)) bool
  (each y xs (if (= y x) (then (return true))))
  (return false))

(fn prelude_position_bool ((xs bool[]) (x bool)) int
  (let i 0)
  (each y xs (set i (+ i 1)) (if (= y x) (then (return i))))
  (return 0))

(fn prelude_count_bool ((xs bool[]) (x bool)) int
  (let n 0)
  (each y xs (if (= y x) (then (set n (+ n 1)))))
  (return n))

; Takes out the first of the items equal to x; nothing happens when it isn't
; there.
(fn prelude_remove_int ((xs int[]) (x int))
  (let i 0)
  (each y xs (if (= y x) (then (remove-at xs i) (return))) (set i (+ i 1))))

(fn prelude_remove_float ((xs float[]) (x float))
  (let i 0)
  (each y xs (if (= y x) (then (remove-at xs i) (return))) (set i (+ i 1))))

(fn prelude_remove_str ((xs str[]) (x str))
  (let i 0)
  (each y xs (if (= y x) (then (remove-at xs i) (return))) (set i (+ i 1))))

(fn prelude_remove_bool ((xs bool[]) (x bool))
  (let i 0)
  (each y xs (if (= y x) (then (remove-at xs i) (return))) (set i (+ i 1))))
