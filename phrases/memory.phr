# Memory (docs/proposals/memory.md). Everything a program makes lives in the
# program's memory until `free`d, or in a new memory that is freed whole.

expr  new memory                                  : memory => (new-memory)
      alias: a new memory
stmt  with new memory : BLOCK                              => (with-new-memory BLOCK)
stmt  with {m: memory} : BLOCK                             => (with-memory $m BLOCK)
stmt  clear {m: memory}                                    => (clear-memory $m)
stmt  free {x: any}                                        => (free $x)
expr  keep {x: T}                                 : T      => (keep $x)
