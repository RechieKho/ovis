; Generic functions for phrases with a `field of T` slot (records.phr). The
; front end copies one for each record ($T) and field ($F) a program uses,
; as prelude_NAME__RECORD__FIELD.

(fn prelude_total_by:$T:$F ((xs (list (record $T))))
  (let total 0)
  (each x xs (set total (+ total (field x $F))))
  total)

; Insertion sort: stable, so records with equal fields keep their order.
(fn prelude_sort_by:$T:$F ((xs (list (record $T))))
  (for i 1 (- (len xs) 1)
    (let x (get xs i))
    (let j (- i 1))
    (while (and (>= j 0) (> (field (get xs j) $F) (field x $F)))
      (put xs (+ j 1) (get xs j))
      (set j (- j 1)))
    (put xs (+ j 1) x)))

(fn prelude_sorted_by:$T:$F ((xs (list (record $T))))
  (let copy (array (record $T) 0))
  (each x xs (append copy x))
  (prelude_sort_by:$T:$F copy)
  copy)

; The first of the highest or lowest, so ties go to the earliest.
(fn prelude_highest_by:$T:$F ((xs (list (record $T))))
  (let best (get xs 0))
  (each x xs (if (> (field x $F) (field best $F)) (then (set best x))))
  best)

(fn prelude_lowest_by:$T:$F ((xs (list (record $T))))
  (let best (get xs 0))
  (each x xs (if (< (field x $F) (field best $F)) (then (set best x))))
  best)
