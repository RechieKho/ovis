# Text. Positions count from 1, as people do.

expr  length of {s: str}                        : int    => (strlen $s)
      alias: number of characters in {s}
expr  character {i: int} of {s: str}            : str    => (substring $s (- $i 1) 1)
expr  first character of {s: str}               : str    => (substring $s 0 1)
expr  last character of {s: str}                : str    => (substring $s (- (strlen $s) 1) 1)
expr  part of {s: str} from {a: int} to {b: int} : str   => (prelude_part $s $a $b)
expr  {s: str} is empty                         : bool   => (= (strlen $s) 0)
expr  {s: str} contains {t: str}                : bool   => (prelude_text_contains $s $t)
expr  {s: str} starts with {t: str}             : bool   => (prelude_starts_with $s $t)
expr  {s: str} ends with {t: str}               : bool   => (prelude_ends_with $s $t)
expr  position of {t: str} in {s: str}          : int    => (prelude_text_position $s $t)
expr  {a: str} comes before {b: str}            : bool   => (< (strcmp $a $b) 0)

expr  {s: str} in capitals                      : str    => (prelude_upper $s)
      alias: {s} in upper case
expr  {s: str} in small letters                 : str    => (prelude_lower $s)
      alias: {s} in lower case
expr  {s: str} reversed                         : str    => (prelude_reverse_text $s)
expr  {s: str} trimmed                          : str    => (prelude_trim $s)
expr  {s: str} repeated {n: int} times          : str    => (prelude_repeat_text $s $n)
expr  {s: str} with {a: str} replaced by {b: str} : str  => (prelude_replace $s $a $b)

expr  words of {s: str}                         : str[]  => (prelude_split $s " ")
expr  {s: str} split by {sep: str}              : str[]  => (prelude_split $s $sep)
expr  number of words in {s: str}               : int    => (prelude_count_words $s)
expr  number of letters in {s: str}             : int    => (prelude_count_letters $s)
expr  code of {c: str}                          : int    => (char_at $c 0)
expr  the character with code {n: int}          : str    => (chr $n)
