# Counts from 1 to 15, saying Fizz for multiples of 3, Buzz for multiples
# of 5, and FizzBuzz for multiples of both.
counting = the numbers from 1 to 15
for each i in counting:
    if i is divisible by 15:
        show "FizzBuzz"
    otherwise if i is divisible by 3:
        show "Fizz"
    otherwise if i is divisible by 5:
        show "Buzz"
    otherwise:
        show i
