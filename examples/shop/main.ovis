# A basket's total after the discount, and with tax, using the phrases the
# pricing files define.
basket = [12.50, 4.00, 30.25]
discounted = apply the discount to the total of basket
after_discount = discounted with 2 decimals
show "After discount:", after_discount
taxed = add tax to discounted
with_tax = taxed with 2 decimals
show "With tax:", with_tax
