# Writes OUTPUT, a C++ file holding every phrases/*.phr file under
# PHRASE_DIR, so the built-in phrase library is part of the binary.
# Run with: cmake -DPHRASE_DIR=... -DOUTPUT=... -P embed_phrases.cmake
file(GLOB phrase_files RELATIVE ${PHRASE_DIR} ${PHRASE_DIR}/*.phr)
list(SORT phrase_files)
set(text "// Generated by cmake/embed_phrases.cmake from phrases/*.phr.\n")
string(APPEND text "#include <ovis/phrase/templates.hpp>\n\n")
string(APPEND text "namespace ovis::phrase {\n\n")
string(APPEND text "auto builtin_phrase_files()\n")
string(APPEND text "    -> const std::vector<std::pair<string_view_type, string_view_type>> & {\n")
string(APPEND text "  static const std::vector<std::pair<string_view_type, string_view_type>> files = {\n")
foreach(file ${phrase_files})
  file(READ ${PHRASE_DIR}/${file} contents)
  string(FIND "${contents}" ")ovis_phrases\"" clash)
  if(NOT clash EQUAL -1)
    message(FATAL_ERROR "${file} contains the raw-string delimiter )ovis_phrases\"")
  endif()
  string(APPEND text "      {\"${file}\", R\"ovis_phrases(${contents})ovis_phrases\"},\n")
endforeach()
string(APPEND text "  };\n  return files;\n}\n\n} // namespace ovis::phrase\n")
# Only touch the file when it changes, so nothing rebuilds needlessly.
file(WRITE ${OUTPUT}.new "${text}")
configure_file(${OUTPUT}.new ${OUTPUT} COPYONLY)
file(REMOVE ${OUTPUT}.new)
