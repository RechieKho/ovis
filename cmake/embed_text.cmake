# Writes OUTPUT, a C++ file with a function NAME returning INPUT's text, so a
# data file is part of the binary.
# Run with: cmake -DINPUT=... -DOUTPUT=... -DNAME=... [-DHEADER=...
# -DNAMESPACE=...] -P embed_text.cmake (by default the phrase checker's).
if(NOT HEADER)
  set(HEADER ovis/phrase/phrase_check.hpp)
endif()
if(NOT NAMESPACE)
  set(NAMESPACE ovis::phrase)
endif()
file(READ ${INPUT} contents)
string(FIND "${contents}" ")ovis_text\"" clash)
if(NOT clash EQUAL -1)
  message(FATAL_ERROR "${INPUT} contains the raw-string delimiter )ovis_text\"")
endif()
set(text "// Generated by cmake/embed_text.cmake from ${INPUT}.\n")
string(APPEND text "#include <${HEADER}>\n\n")
string(APPEND text "namespace ${NAMESPACE} {\n\n")
string(APPEND text "auto ${NAME}() -> string_view_type {\n")
string(APPEND text "  return R\"ovis_text(${contents})ovis_text\";\n}\n\n")
string(APPEND text "} // namespace ${NAMESPACE}\n")
file(WRITE ${OUTPUT}.new "${text}")
configure_file(${OUTPUT}.new ${OUTPUT} COPYONLY)
file(REMOVE ${OUTPUT}.new)
